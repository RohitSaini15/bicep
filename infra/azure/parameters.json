{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "dev"
    },
    "resourceNamePrefix": {
      "value": "taxi"
    },
    "removalPolicy": {
      "value": "Delete"
    },
    "enableDailyScheduling": {
      "value": false
    },
    "yellowSourcePath": {
      "value": "data/NY-Pub/year=2016/month=1/type=yellow"
    },
    "greenSourcePath": {
      "value": "data/NY-Pub/year=2016/month=1/type=green"
    },
    "targetDatabaseName": {
      "value": "spark_data_lake"
    },
    "targetTableName": {
      "value": "aggregated_trip_distance"
    }
  }
}